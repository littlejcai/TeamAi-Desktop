{
  "name": "@teamai-desktop/desktop",
  "version": "0.5.1",
  "private": true,
  "description": "TeamAI Desktop — Electron 应用",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/service.test.cjs test/core-integration.test.cjs",
    "test:e2e": "playwright test",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@teamai-desktop/ipc-contract": "workspace:*",
    "diff": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "teamai-cli": "github:littlejcai/teamai-cli#daf2c84baae5313d3c33f43757fad73f90ce5e50",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "selfsigned": "^2.4.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.teamai.desktop",
    "productName": "TeamAI Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "dist/**",
      "package.json",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "TeamAI-Desktop-${version}-Setup-${arch}.${ext}",
      "runAfterFinish": false,
      "shortcutName": "TeamAI Desktop",
      "uninstallDisplayName": "TeamAI Desktop"
    },
    "publish": {
      "provider": "github",
      "owner": "littlejcai",
      "repo": "TeamAi-Desktop"
    },
    "asarUnpack": [
      "**/*.wasm"
    ],
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "teamai-desktop",
      "icon": "assets/icon.png"
    },
    "artifactName": "TeamAI-Desktop-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "TeamAI-Desktop-${version}-Portable-${arch}.${ext}"
    }
  },
  "files": [
    "src",
    "dist",
    "package.json",
    "assets"
  ],
  "author": "littlejcai"
}
